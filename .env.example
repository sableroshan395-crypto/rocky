# Rocky's Workspace — Environment Configuration Template
# Copy this file to .env and insert your real Firebase project credentials when ready.
# Note: The application will run cleanly in Local Workspace Mode even if this file is not configured.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
